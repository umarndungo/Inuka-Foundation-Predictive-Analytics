# Copy to .env and adjust as needed. Defaults already match docker-compose.yml.

DATABASE_URL=postgresql+asyncpg://inuka:inuka@localhost:5433/inuka_risk_radar
DATABASE_URL_SYNC=postgresql://inuka:inuka@localhost:5433/inuka_risk_radar

KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC_ALERTS=system.alerts

N8N_WEBHOOK_URL=http://localhost:5678/webhook/inuka-risk-alert
N8N_WEBHOOK_TIMEOUT_SECONDS=5.0

AUTOMATION_THRESHOLD=0.75

# JSON array — pydantic-settings parses this into list[str]
CORS_ORIGINS=["http://localhost:3000"]

TELEMETRY_POLL_INTERVAL_SECONDS=2.0
TELEMETRY_BATCH_LIMIT=20
