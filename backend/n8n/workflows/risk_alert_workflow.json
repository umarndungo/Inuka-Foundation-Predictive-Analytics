{
  "name": "Inuka Risk Radar - Email Escalation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inuka-risk-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1a2b3c4d-0001-4a11-8000-000000000001",
      "name": "Webhook - risk alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "inuka-risk-alert"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "email-subject",
              "name": "email_subject",
              "type": "string",
              "value": "=INUKA ALERT: Beneficiary {{$json.body.beneficiary_id}} is {{$json.body.risk_tier}} risk (score {{$json.body.risk_score}}) in {{$json.body.region}}"
            },
            {
              "id": "email-body",
              "name": "email_body",
              "type": "string",
              "value": "=<h2>INUKA Risk Alert</h2><p>A beneficiary has been flagged as <strong>{{$json.body.risk_tier}}</strong> risk.</p><table style='border-collapse:collapse;width:100%;max-width:500px'><tr><td style='padding:8px;border:1px solid #ddd;font-weight:bold'>Beneficiary ID</td><td style='padding:8px;border:1px solid #ddd'>{{$json.body.beneficiary_id}}</td></tr><tr><td style='padding:8px;border:1px solid #ddd;font-weight:bold'>Risk Score</td><td style='padding:8px;border:1px solid #ddd'>{{$json.body.risk_score}}</td></tr><tr><td style='padding:8px;border:1px solid #ddd;font-weight:bold'>Risk Tier</td><td style='padding:8px;border:1px solid #ddd'>{{$json.body.risk_tier}}</td></tr><tr><td style='padding:8px;border:1px solid #ddd;font-weight:bold'>Region</td><td style='padding:8px;border:1px solid #ddd'>{{$json.body.region}}</td></tr><tr><td style='padding:8px;border:1px solid #ddd;font-weight:bold'>Alert ID</td><td style='padding:8px;border:1px solid #ddd'>{{$json.body.alert_id}}</td></tr><tr><td style='padding:8px;border:1px solid #ddd;font-weight:bold'>Triggered At</td><td style='padding:8px;border:1px solid #ddd'>{{$json.body.triggered_at}}</td></tr></table><p style='margin-top:16px;color:#666;font-size:12px'>This is an automated alert from Inuka Risk Radar. Please schedule a field visit for this beneficiary.</p>"
            },
            {
              "id": "recipient-email",
              "name": "recipient_email",
              "type": "string",
              "value": "={{$env.FIELD_WORKER_EMAIL || 'omarnjagi@gmail.com'}}"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0002-4a11-8000-000000000002",
      "name": "Format Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "sendTo": "={{$json.recipient_email}}",
        "subject": "={{$json.email_subject}}",
        "emailType": "html",
        "message": "={{$json.email_body}}",
        "options": {}
      },
      "id": "1a2b3c4d-0003-4a11-8000-000000000003",
      "name": "Gmail - send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [700, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Webhook - risk alert": {
      "main": [
        [
          { "node": "Format Email", "type": "main", "index": 0 }
        ]
      ]
    },
    "Format Email": {
      "main": [
        [
          { "node": "Gmail - send email", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
